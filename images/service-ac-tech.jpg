<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 900" width="1200" height="900" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="bg_9" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#06263b"/>
      <stop offset="60%" stop-color="#0369a1"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <radialGradient id="radial_9" cx="50%" cy="35%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.32"/>
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="cardGrad_9" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.14"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.03"/>
    </linearGradient>
  </defs>

  <!-- Deep Background -->
  <rect width="1200" height="900" fill="url(#bg_9)"/>
  
  <!-- Subtle Grid Accent -->
  <g stroke="#ffffff" stroke-opacity="0.04" stroke-width="1">
    <line x1="0" y1="150" x2="1200" y2="150"/>
    <line x1="0" y1="300" x2="1200" y2="300"/>
    <line x1="0" y1="450" x2="1200" y2="450"/>
    <line x1="0" y1="600" x2="1200" y2="600"/>
    <line x1="0" y1="750" x2="1200" y2="750"/>
    <line x1="200" y1="0" x2="200" y2="900"/>
    <line x1="400" y1="0" x2="400" y2="900"/>
    <line x1="600" y1="0" x2="600" y2="900"/>
    <line x1="800" y1="0" x2="800" y2="900"/>
    <line x1="1000" y1="0" x2="1000" y2="900"/>
  </g>

  <!-- Ambient Glow -->
  <circle cx="600" cy="340" r="420" fill="url(#radial_9)"/>

  <!-- Centered Glass Card -->
  <rect x="360" y="160" width="480" height="420" rx="32" fill="url(#cardGrad_9)" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1.5"/>

  <!-- Icon Circle -->
  <g transform="translate(600, 270)">
    <circle cx="0" cy="0" r="64" fill="#38bdf8" fill-opacity="0.2" stroke="#38bdf8" stroke-width="2.5"/>
    <circle cx="0" cy="0" r="50" fill="#ffffff" fill-opacity="0.1"/>
    <text x="0" y="20" font-size="48" text-anchor="middle" font-family="'Segoe UI Emoji', 'Apple Color Emoji', sans-serif">❄️</text>
  </g>

  <!-- Badge Pill -->
  <g transform="translate(600, 385)">
    <rect x="-140" y="-18" width="280" height="36" rx="18" fill="#38bdf8" fill-opacity="0.25" stroke="#38bdf8" stroke-width="1.5"/>
    <text x="0" y="5" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="700" font-size="14" fill="#ffffff" text-anchor="middle" letter-spacing="0.05em">FIELDSYNC VERIFIED</text>
  </g>

  <!-- Title & Description inside graphic -->
  <text x="600" y="465" font-family="'Outfit', system-ui, -apple-system, sans-serif" font-weight="800" font-size="34" fill="#ffffff" text-anchor="middle" letter-spacing="-0.02em">HVAC &amp; AC Technicians</text>
  <text x="600" y="505" font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-weight="500" font-size="16" fill="#cbd5e1" text-anchor="middle">Gas recharging, deep jet cleaning, compressor diagnostics</text>

  <!-- Subtle corner decorative badges -->
  <g transform="translate(100, 100)" opacity="0.6">
    <circle cx="0" cy="0" r="6" fill="#38bdf8"/>
    <circle cx="20" cy="0" r="6" fill="#ffffff" fill-opacity="0.2"/>
    <circle cx="40" cy="0" r="6" fill="#ffffff" fill-opacity="0.2"/>
  </g>
</svg>